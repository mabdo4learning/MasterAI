# Supabase → Project Settings → API (or "API Keys")
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe to expose in the browser.
VITE_SUPABASE_KEY=YOUR-PUBLISHABLE-KEY

# Payments (Paddle Billing) — optional; without them the app runs with the free plan only.
# Paddle → Developer tools → Authentication → Client-side tokens (test_... in sandbox, live_... in production)
VITE_PADDLE_CLIENT_TOKEN=
# "sandbox" while testing, "production" when live
VITE_PADDLE_ENV=sandbox
# Paddle → Catalog → your Pro product → the two prices (pri_...)
VITE_PADDLE_PRICE_MONTHLY=
VITE_PADDLE_PRICE_YEARLY=
